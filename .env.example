# Copie ce fichier en .env :  cp .env.example .env
# Docker Compose lit automatiquement .env, les valeurs ci-dessous s'appliquent
# alors a toutes les commandes make, sans avoir a les repeter.

# Jeton Hugging Face, pour pousser et recuperer datasets et checkpoints.
# A creer sur huggingface.co > Settings > Access Tokens.
HF_TOKEN=

# Variante d'image.
#   ghcr.io/alsacedigitale/robotkraft:latest  variante CPU, environ 2,7 Go (defaut)
#   ghcr.io/alsacedigitale/robotkraft:cuda    variante CUDA, environ 9 Go
#
# Ne prends la variante CUDA que si ton portable a un GPU NVIDIA et que tu veux
# entrainer en local. Sinon l'entrainement se fait sur les serveurs distants et
# la variante par defaut suffit.
#
# Attention : cette valeur doit etre dans .env, pas passee en ligne de commande.
# Un ROBOTKRAFT_IMAGE=... devant un docker compose pull ne vaut que pour cette
# commande, et make train repartirait ensuite sur la variante CPU, entrainant
# sur processeur sans rien signaler.
#ROBOTKRAFT_IMAGE=ghcr.io/alsacedigitale/robotkraft:cuda
